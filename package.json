{
  "name": "ninja-arena-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "sync": "node scripts/sync-data.mjs && node scripts/sync-animations.mjs",
    "sync:data": "node scripts/sync-data.mjs",
    "sync:animations": "node scripts/sync-animations.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run"
  },
  "dependencies": {
    "long": "^5.3.2",
    "pixi.js": "^8.14.0",
    "protobufjs": "^7.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "csv-parse": "^7.0.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.12"
  }
}
